# dev/.env.example — copy to dev/.env and adjust.
# All deploy/infra specifics live ONLY here (and in dev/.env), never in scripts.

# ---- deploy.sh ----
# SSH alias of the deploy host (see ~/.ssh/config)
DEPLOY_TARGET=

# Docroot path on the target host
DEPLOY_PATH=

# Owner applied to deployed files via rsync --chown (empty = keep ssh user)
DEPLOY_OWNER=

# Remote path for the uploaded DB dump (with --db)
DB_DUMP_REMOTE=

# ---- fetch.sh ----
# phpBB directory on the deploy host; config.php inside supplies the DB creds
FORUM_DIR_REMOTE=

# ---- docker-compose.yml (local website + phpBB mirror) ----
# Directory with the phpBB3 files used inside the web container
FORUM_DIR=

# SQL dump imported into MariaDB on first boot (fresh volume only)
FORUM_SQL_DUMP=

# MariaDB credentials for the local mirror container
# (DB_PASS must match the forum config.php so it connects unchanged)
DB_NAME=
DB_USER=
DB_PASS=
DB_ROOT_PASS=

# ---- upstream submission (dev/upstream/) ----
# freedesktop.org GitLab account for the xkeyboard-config MR
GITLAB_USER=
GITLAB_EMAIL=
GITLAB_PASSWORD=
GITLAB_TOKEN=
